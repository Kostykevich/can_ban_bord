# =====================================================================
#  .env для VDS (Windows Server) — образец
#
#  Как пользоваться:
#    1. На сервере:  Copy-Item deploy\vds.env.example .env
#    2. notepad .env  — заполните строки с пометкой «ВПИШИТЕ»
#    3. Сохраните (Ctrl + S). Никому не пересылайте этот файл.
#
#  В примерах ниже домен — kanban.vektor-rp.ru. Замените на СВОЙ.
#  IP-адрес сервера в этот файл НЕ пишется — он указывается только
#  у регистратора домена (A-запись: kanban → IP сервера).
# =====================================================================


# ---------- 1. Секретный ключ (ВПИШИТЕ) ----------
# Сгенерируйте НОВЫЙ ключ прямо на сервере:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# и вставьте результат после знака «=» (без пробелов и кавычек).
VEKTOR_SECRET_KEY=


# ---------- 2. Адрес сайта (ВПИШИТЕ свой домен) ----------
# С https:// в начале, без слеша в конце.
PUBLIC_URL=https://kanban.vektor-rp.ru

# Только домен: без https:// и без слешей.
# Несколько доменов — через запятую: kanban.vektor-rp.ru,www.kanban.vektor-rp.ru
ALLOWED_HOSTS=kanban.vektor-rp.ru


# ---------- 3. Вход через Discord (необязательно) ----------
# Discord Developer Portal → ваше приложение → OAuth2.
# Не нужен вход через Discord — оставьте все три строки пустыми.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Ваш домен + /auth/discord/callback. ТОЧНО такой же адрес добавьте
# в Developer Portal → OAuth2 → Redirects (символ в символ).
DISCORD_REDIRECT_URI=https://kanban.vektor-rp.ru/auth/discord/callback


# ---------- 4. Discord-бот (необязательно) ----------
# Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=
# ПКМ по каналу в Discord → «Копировать ID» (нужен режим разработчика)
DISCORD_CHANNEL_ID=


# Только если хостинг БЛОКИРУЕТ Discord (проверка: scripts\check_discord.py).
# HTTP-прокси вне РФ: http://адрес:порт или http://логин:пароль@адрес:порт
# Иначе оставьте пустым.
DISCORD_PROXY=
# То же для Telegram, если хостинг блокирует api.telegram.org (видно в профиле на сайте)
TELEGRAM_PROXY=


# ---------- 5. Telegram-бот (необязательно) ----------
# @BotFather → /newbot. Перед запуском на сервере выключите сайт на своём ПК:
# один бот не может работать в двух местах одновременно.
TELEGRAM_BOT_TOKEN=


# ---------- 6. Серверные настройки — НЕ МЕНЯЙТЕ ----------
# Сайт работает через HTTPS (защищённые cookie, HSTS)
HTTPS=1
# Перед сайтом стоит Caddy — доверять его заголовкам (настоящий IP посетителя)
TRUST_PROXY=1
# Внутренний адрес и порт: Caddy передаёт сюда запросы внутри сервера.
# 127.0.0.1 — это «сам сервер», а НЕ ваш внешний IP. Не меняйте.
# Порт 8000 в брандмауэре НЕ открывайте.
HOST=127.0.0.1
PORT=8000
