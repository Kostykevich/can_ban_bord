# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в git.
# Никому не присылайте содержимое .env.

# Секретный ключ для подписи сессий. Сгенерировать:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# Если оставить пустым при локальной разработке — ключ создастся автоматически в instance\secret_key.
VEKTOR_SECRET_KEY=

# Публичный адрес сайта (нужен для ссылок в Discord и для redirect URI)
PUBLIC_URL=http://127.0.0.1:5000

# --- Вход через Discord (необязательно) ---
# Discord Developer Portal -> Applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Должен ТОЧНО совпадать с Redirect в настройках Discord-приложения
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/auth/discord/callback

# --- Discord-бот: уведомления в личку и в канал сервера (необязательно) ---
# Developer Portal -> ваше приложение -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# ID канала для общих уведомлений (ПКМ по каналу -> Копировать ID; нужен режим разработчика)
DISCORD_CHANNEL_ID=
# HTTP-прокси, если Discord заблокирован у провайдера/хостинга (иначе пусто)
DISCORD_PROXY=
# То же для Telegram, если хостинг блокирует api.telegram.org (видно в профиле на сайте)
TELEGRAM_PROXY=

# --- Telegram-бот: личные уведомления (необязательно) ---
# Создать бота: @BotFather -> /newbot -> скопировать токен
# Имя, описание и меню команд бот оформит сам при запуске; аватар — scripts\setup_telegram_bot.py
TELEGRAM_BOT_TOKEN=

# --- Только для сервера (VDS) ---
# Сайт работает через HTTPS (включает Secure-cookie и HSTS)
HTTPS=0
# Приложение стоит за reverse proxy (Caddy) — доверять заголовкам X-Forwarded-*
TRUST_PROXY=0
# Разрешённые домены через запятую, например: kanban.vektor-rp.ru
ALLOWED_HOSTS=
# Адрес и порт для Waitress. 127.0.0.1 = сайт недоступен снаружи напрямую (так и нужно)
HOST=127.0.0.1
PORT=8000
